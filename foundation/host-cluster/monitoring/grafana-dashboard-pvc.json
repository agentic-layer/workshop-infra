{
  "annotations": {
    "list": []
  },
  "description": "Kubernetes Persistent Volume Claim usage monitoring. Adapted from community dashboard 13646 for OTel kubeletstats metrics.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          },
          "unit": "percent"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Namespace" },
            "properties": [{ "id": "custom.width", "value": 150 }]
          },
          {
            "matcher": { "id": "byName", "options": "PVC" },
            "properties": [{ "id": "custom.width", "value": 300 }]
          },
          {
            "matcher": { "id": "byName", "options": "Capacity" },
            "properties": [
              { "id": "unit", "value": "bytes" },
              { "id": "decimals", "value": 1 },
              { "id": "custom.width", "value": 100 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Used" },
            "properties": [
              { "id": "unit", "value": "bytes" },
              { "id": "decimals", "value": 1 },
              { "id": "custom.width", "value": 100 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Available" },
            "properties": [
              { "id": "unit", "value": "bytes" },
              { "id": "decimals", "value": 1 },
              { "id": "custom.width", "value": 100 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Usage %" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "gradient",
                  "type": "gauge"
                }
              },
              { "id": "custom.width", "value": 200 },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 100 }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Usage %" }]
      },
      "title": "PVC Usage Overview",
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "k8s_persistentvolumeclaim_name", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "k8s_namespace_name 2": true,
              "k8s_namespace_name 3": true,
              "k8s_namespace_name 4": true,
              "k8s_node_name 1": true,
              "k8s_node_name 2": true,
              "k8s_node_name 3": true,
              "k8s_node_name 4": true,
              "k8s_pod_name 1": true,
              "k8s_pod_name 2": true,
              "k8s_pod_name 3": true,
              "k8s_pod_name 4": true,
              "k8s_volume_name 1": true,
              "k8s_volume_name 2": true,
              "k8s_volume_name 3": true,
              "k8s_volume_name 4": true,
              "k8s_volume_type 1": true,
              "k8s_volume_type 2": true,
              "k8s_volume_type 3": true,
              "k8s_volume_type 4": true
            },
            "renameByName": {
              "k8s_namespace_name 1": "Namespace",
              "k8s_persistentvolumeclaim_name": "PVC",
              "Value #Capacity": "Capacity",
              "Value #Used": "Used",
              "Value #Available": "Available",
              "Value #Usage": "Usage %"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "k8s_volume_capacity{k8s_namespace_name=~\"$namespace\", k8s_persistentvolumeclaim_name=~\"$pvc\", k8s_persistentvolumeclaim_name!=\"\"}",
          "format": "table",
          "instant": true,
          "refId": "Capacity"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "k8s_volume_capacity{k8s_namespace_name=~\"$namespace\", k8s_persistentvolumeclaim_name=~\"$pvc\", k8s_persistentvolumeclaim_name!=\"\"} - k8s_volume_available{k8s_namespace_name=~\"$namespace\", k8s_persistentvolumeclaim_name=~\"$pvc\", k8s_persistentvolumeclaim_name!=\"\"}",
          "format": "table",
          "instant": true,
          "refId": "Used"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "k8s_volume_available{k8s_namespace_name=~\"$namespace\", k8s_persistentvolumeclaim_name=~\"$pvc\", k8s_persistentvolumeclaim_name!=\"\"}",
          "format": "table",
          "instant": true,
          "refId": "Available"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "100 * (1 - k8s_volume_available{k8s_namespace_name=~\"$namespace\", k8s_persistentvolumeclaim_name=~\"$pvc\", k8s_persistentvolumeclaim_name!=\"\"} / k8s_volume_capacity{k8s_namespace_name=~\"$namespace\", k8s_persistentvolumeclaim_name=~\"$pvc\", k8s_persistentvolumeclaim_name!=\"\"})",
          "format": "table",
          "instant": true,
          "refId": "Usage"
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
      "id": 3,
      "title": "Alerts",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 12 },
      "id": 4,
      "options": {
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto"
      },
      "title": "PVCs above 80% usage",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "100 * (1 - k8s_volume_available{k8s_namespace_name=~\"$namespace\", k8s_persistentvolumeclaim_name=~\"$pvc\", k8s_persistentvolumeclaim_name!=\"\"} / k8s_volume_capacity{k8s_namespace_name=~\"$namespace\", k8s_persistentvolumeclaim_name=~\"$pvc\", k8s_persistentvolumeclaim_name!=\"\"}) >= 80",
          "legendFormat": "{{k8s_namespace_name}}/{{k8s_persistentvolumeclaim_name}}",
          "refId": "A"
        }
      ],
      "type": "gauge"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 5,
      "title": "Usage Over Time",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": {
              "mode": "line",
              "line": { "color": "red", "width": 1 }
            }
          },
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "red", "value": 90 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 19 },
      "id": 6,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "right",
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "PVC Usage % Over Time",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "100 * (1 - k8s_volume_available{k8s_namespace_name=~\"$namespace\", k8s_persistentvolumeclaim_name=~\"$pvc\", k8s_persistentvolumeclaim_name!=\"\"} / k8s_volume_capacity{k8s_namespace_name=~\"$namespace\", k8s_persistentvolumeclaim_name=~\"$pvc\", k8s_persistentvolumeclaim_name!=\"\"})",
          "legendFormat": "{{k8s_namespace_name}}/{{k8s_persistentvolumeclaim_name}}",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "min": 0,
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 29 },
      "id": 7,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "table",
          "placement": "right",
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "PVC Available Space Over Time",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "k8s_volume_available{k8s_namespace_name=~\"$namespace\", k8s_persistentvolumeclaim_name=~\"$pvc\", k8s_persistentvolumeclaim_name!=\"\"}",
          "legendFormat": "{{k8s_namespace_name}}/{{k8s_persistentvolumeclaim_name}}",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 },
      "id": 8,
      "title": "Inodes",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": {
              "mode": "line",
              "line": { "color": "red", "width": 1 }
            }
          },
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "red", "value": 90 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 40 },
      "id": 9,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "right",
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Inode Usage % Over Time",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "100 * k8s_volume_inodes_used{k8s_namespace_name=~\"$namespace\", k8s_persistentvolumeclaim_name=~\"$pvc\", k8s_persistentvolumeclaim_name!=\"\"} / k8s_volume_inodes{k8s_namespace_name=~\"$namespace\", k8s_persistentvolumeclaim_name=~\"$pvc\", k8s_persistentvolumeclaim_name!=\"\"}",
          "legendFormat": "{{k8s_namespace_name}}/{{k8s_persistentvolumeclaim_name}}",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["kubernetes", "pvc", "storage", "volume"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
