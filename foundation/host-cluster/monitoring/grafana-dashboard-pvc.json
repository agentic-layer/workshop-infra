      },
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(k8s_volume_capacity{k8s_persistentvolumeclaim_name!=\"\"}, k8s_namespace_name)",
        "hide": 0,
        "includeAll": true,
        "label": "Namespace",
        "multi": true,
        "name": "namespace",
        "options": [],
        "query": "label_values(k8s_volume_capacity{k8s_persistentvolumeclaim_name!=\"\"}, k8s_namespace_name)",
        "refresh": 2,
