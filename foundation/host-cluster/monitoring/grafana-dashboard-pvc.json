        "sort": 1,
        "type": "query"
      },
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(k8s_volume_capacity{k8s_namespace_name=~\"$namespace\", k8s_persistentvolumeclaim_name!=\"\"}, k8s_persistentvolumeclaim_name)",
        "hide": 0,
        "includeAll": true,
        "label": "PVC",
        "multi": true,
        "name": "pvc",
        "options": [],
